# Définir la touche mod (Super/Windows)
set $mod Mod4

# Définir la police
font pango:JetBrains Mono Nerd Font 10

# Configurer les gaps (espacements)
gaps inner 10
gaps outer 10
smart_gaps off

# Configurer les bordures
new_window pixel 4
new_float normal

# Raccourcis clavier
bindsym $mod+Return exec kitty
bindsym $mod+d exec rofi -show drun -theme ~/.config/rofi/config.rasi
bindsym $mod+q kill
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exit
bindsym $mod+b exec brave-browser
bindsym $mod+Shift+l exec ~/.local/bin/lock.sh

# Espaces de travail
set $ws1 "Home"
set $ws2 "Web"
set $ws3 "Files"
set $ws4 "Code"

# Assignation des raccourcis clavier
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4

# Couleur des bordures
client.focused          #cad3f5 #cad3f5 #cad3f5 #cad3f5
client.focused_inactive #24273a #24273a #24273a #24273a
client.unfocused        #24273a #24273a #24273a #24273a
client.urgent           #E78284 #E78284 #E78284 #E78284
client.placeholder      #24273a #24273a #24273a #24273a

# Règles pour les fenêtres flottantes
for_window [class="Pavucontrol"] floating enable
for_window [class="feh"] floating enable
for_window [class="Arandr"] floating enable

# Définir le fond d'écran
exec feh --bg-fill ~/.config/wallpapers/bg_co_pastel.png

# Lancer Picom pour les effets de transparence
exec --no-startup-id picom --config ~/.config/picom/picom.conf

# Lancer Polybar
exec --no-startup-id ~/.config/polybar/launch.sh
